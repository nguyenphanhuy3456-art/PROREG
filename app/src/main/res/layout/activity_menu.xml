<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:text="@string/menu_title"
        android:textColor="@color/accent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/txtHeadshot"
        android:text="Headshot: 50%"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <SeekBar
        android:id="@+id/sbHeadshot"
        android:max="90"
        android:progress="40"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Switch android:id="@+id/swAim" android:text="@string/menu_aim"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Switch android:id="@+id/swEsp" android:text="@string/menu_esp"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Switch android:id="@+id/swVpn" android:text="@string/menu_vpn"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Switch android:id="@+id/swAntiban" android:text="@string/menu_antiban"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
